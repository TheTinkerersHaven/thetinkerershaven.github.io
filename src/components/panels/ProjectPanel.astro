---
import { projects } from "../../data/projects";
import ProjectTile from "../ProjectTile.astro";
import PanelLayout from "../wrappers/PanelLayout.astro";
---

<PanelLayout data-panel data-bg="60 30 100">
    <h2 class="fade-in" style="--delay: 0.1s">My projects</h2>
    <p class="fade-in" style="--delay: 0.2s">These are some of the projects I've worked on:</p>
    <div class="fade-in" id="projects-grid" style="--delay: 0.3s">
        {projects.map((p, i) => (
            <ProjectTile
                link={p.link}
                name={p.name}
                madeWith={p.madeWith}
                madeFor={p.madeFor}
                madeForLink={p.madeForLink}
                wide={p.wide}
                style={{ "--delay": `${0.1 + i * 0.1}s` }}
            >
                <p class="description" slot="description" set:html={p.description} />
            </ProjectTile>
        ))}
    </div>
</PanelLayout>

<style>
    :root {
        --table-border-color: #ffffff50;
    }

    #projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    @media (max-width: 768px) {
        #projects-grid {
            grid-template-columns: 1fr;
        }
    }

    .description {
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.9rem;
        margin: 0.2rem 0;
    }
</style>
