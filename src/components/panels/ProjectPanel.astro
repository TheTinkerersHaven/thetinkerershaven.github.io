---
import PanelLayout from "../wrappers/PanelLayout.astro";
import ProjectTile from "../ProjectTile.astro";
---

<PanelLayout data-panel="3">
    <h2 class="fade-in" style="--delay: 0.1s">My projects</h2>
    <p class="fade-in" style="--delay: 0.2s">
        These are some of the projects I've worked on:
    </p>
    <div class="fade-in" id="projects-grid" style="--delay: 0.3s">
        <ProjectTile
            link="https://github.com/TheTinkerersHaven/minichat"
            name="MiniChat"
            madeWith="Flutter"
            madeFor="PoliCollege"
            madeForLink="https://www.policollege.polimi.it"
            wide
            style={{ "--delay": "0.1s" }}
        >
            <p slot="description">
                A Flutter chat client for LLMs with OpenAI-compatible APIs,
                featuring local speech recognition via Whisper.
            </p>
        </ProjectTile>
        <ProjectTile
            link="https://github.com/TheTinkerersHaven/thetinkerershaven.github.io"
            name="thetinkerershaven.github.io"
            madeWith="Astro"
            madeFor="Myself"
            wide
            style={{ "--delay": "0.2s" }}
        >
            <p slot="description">
                This exact website! First written in Svelte, and then remade
                into what it is now.
            </p>
        </ProjectTile>
        <ProjectTile
            link="https://github.com/PlanckTeam/planckteam.github.io"
            name="planckteam.github.io"
            madeWith="Astro"
            madeFor="Planck Team"
            madeForLink="https://planckteam.github.io"
            style={{ "--delay": "0.3s" }}
        >
            <p slot="description">
                Website for Planck Team (FIRST Lego League &amp; FIRST Tech
                Challenge)
            </p>
        </ProjectTile>
        <ProjectTile
            link="https://github.com/PlanckTeam/Space4Arch"
            name="Space4Arch"
            madeWith="Expo (React Native)"
            madeFor="Planck Team"
            madeForLink="https://planckteam.github.io"
            style={{ "--delay": "0.4s" }}
        >
            <p slot="description">
                Archeology app, innovation project for Planck Team (FIRST Lego
                League 2025-2026) (in collaboration with
                <span class="tooltip"
                    ><a href="https://github.com/Fleny113">@Fleny113</a><span
                        class="tooltiptext">cool guy</span
                    ></span
                >)
            </p>
        </ProjectTile>
        <ProjectTile
            link="https://github.com/TheTinkerersHaven/RestaurantSimulator26"
            name="Restaurant Simulator 26"
            madeWith="Java"
            madeFor="School"
            madeForLink="https://maxplanck.edu.it"
            style={{ "--delay": "0.5s" }}
        >
            <p slot="description">
                Java Swing-based GUI restaurant simulator (in collaboration with
                <span class="tooltip"
                    ><a href="https://github.com/Fleny113">@Fleny113</a><span
                        class="tooltiptext"
                        >did i already tell you he's a cool guy?</span
                    ></span
                >)
            </p>
        </ProjectTile>
        <ProjectTile
            link="https://github.com/TheTinkerersHaven/SpinKeys-Hackpad"
            name="SpinKeys"
            madeWith="KiCad, Vial"
            madeFor="Hack Club Blueprint"
            madeForLink="https://hackclub.com"
            style={{ "--delay": "0.6s" }}
        >
            <p slot="description">
                5-key hackpad with two dials made for Hack Club Blueprint.
            </p>
        </ProjectTile>
        <ProjectTile
            link="https://github.com/TheTinkerersHaven/TerraLevel"
            name="TerraLevel"
            madeWith="Godot"
            madeFor="Hack Club Daydream"
            madeForLink="https://hackclub.com"
            style={{ "--delay": "0.7s" }}
        >
            <p slot="description">
                Platformer tower-climb game made for Hack Club Daydream.
            </p>
        </ProjectTile>
        <ProjectTile
            link="https://github.com/TheTinkerersHaven/CitySim"
            name="CitySim"
            madeWith="C++"
            madeFor="School"
            madeForLink="https://maxplanck.edu.it"
            style={{ "--delay": "0.8s" }}
        >
            <p slot="description">
                Simple TUI-based city simulator (in collaboration with
                <span class="tooltip"
                    ><a href="https://github.com/Fleny113">@Fleny113</a><span
                        class="tooltiptext">cool guy pt.2</span
                    ></span
                >)
            </p>
        </ProjectTile>
        <ProjectTile
            link="https://github.com/TheTinkerersHaven/Encodechet"
            name="Encodechet"
            madeWith="Rust"
            madeFor="Myself"
            style={{ "--delay": "0.9s" }}
        >
            <p slot="description">
                A useless encoder/decoder for text files in the custom .edch
                format, now rewritten in Rust! (in collaboration with
                <span class="tooltip"
                    ><a href="https://github.com/Fleny113">@Fleny113</a><span
                        class="tooltiptext"
                        >co-wrote the original Python version</span
                    ></span
                >)
            </p>
        </ProjectTile>
    </div>
</PanelLayout>

<style>
    :root {
        --table-border-color: #ffffff50;
    }

    .fade-in {
        opacity: 0;
        filter: blur(6px);
        transform: translateY(30px);
    }

    .fade-in.visible {
        animation: projectFadeIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) var(--delay)
            both;
    }

    @keyframes projectFadeIn {
        from {
            opacity: 0;
            filter: blur(6px);
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            filter: blur(0);
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .fade-in {
            opacity: 1;
            filter: none;
            transform: none;
        }
        .fade-in.visible {
            animation: none;
        }
    }

    #projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    @media (max-width: 768px) {
        #projects-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
