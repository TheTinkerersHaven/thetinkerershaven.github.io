---
import { techColors } from "../data/projects";

interface Props {
    link: string;
    name: string;
    madeWith: string;
    madeFor: string;
    madeForLink?: string;
    wide?: boolean;
    style?: string | Record<string, string>;
}

const { link, name, madeWith, madeFor, madeForLink, wide = false, style } = Astro.props;

const techs = madeWith.split(" & ").map((t) => t.trim());
---

<div class="tile fade-in" class:list={{ wide }} style={style}>
    <h3 class="tile-title"><a href={link}>{name}</a></h3>
    <slot name="description" />

    <div class="more-info">
        <div class="separator" />
        <p class="made-for">Made for {madeForLink ? <a href={madeForLink}>{madeFor}</a> : madeFor}</p>
        <p class="made-with">
            Using
            {techs.map((tech, i) => (
                <>
                    {i > 0 && " & "}
                    <span style={{ color: techColors[tech] ?? "#61afef" }}>{tech}</span>
                </>
            ))}
        </p>
    </div>
</div>

<style>
    .tile {
        position: relative;
        background-color: rgba(20, 20, 20, 0.5);
        padding: 1rem;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        cursor: pointer;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease,
            background-color 0.3s ease;
    }

    .tile-title a {
        font-family: var(--font-card-title);
        font-size: 1.7rem;
        font-weight: normal;
        max-width: 100%;
        overflow-wrap: break-word;
        word-break: break-word;
    }

    .tile:hover {
        transform: scale(1.05);
        background-color: rgba(101, 19, 84, 0.8);
        z-index: 10;
        box-shadow: 0 12px 20px rgba(0, 0, 0, 0.4);
    }

    .wide {
        grid-column: span 2;
    }

    @media (max-width: 1600px) {
        .wide {
            grid-column: span 1;
        }
    }

    .more-info {
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        transition:
            opacity 0.3s ease,
            max-height 0.5s ease;
    }

    .tile:hover .more-info {
        opacity: 1;
        max-height: 150px;
    }

    h3 {
        margin-top: 0;
        margin-bottom: 0.5rem;
    }

    p {
        margin: 0.2rem 0;
    }

    .separator {
        width: 100%;
        height: 1px;
        background-color: var(--table-border-color);
        margin: 0.5rem 0;
    }

    .made-for {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.6);
    }

    .made-with {
        font-size: 0.8rem;
        font-weight: 600;
    }
</style>
